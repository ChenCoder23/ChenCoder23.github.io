<article class="article article--page" id="article">
  <header class="article__head">
    <h1 class="article__title"><%= page.title %></h1>
    <% if (page.subtitle) { %><p class="article__subtitle"><%= page.subtitle %></p><% } %>
  </header>
  <div class="prose" id="prose"><%- page.content %></div>
</article>
