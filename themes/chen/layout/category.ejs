<%
var raw = (page.posts && page.posts.toArray) ? page.posts.toArray() : (page.posts || []);
var list = raw.slice().sort(function (a, b) {
  var pa = a.sticky ? 1 : 0, pb = b.sticky ? 1 : 0;
  if (pa !== pb) return pb - pa;
  return b.date - a.date;
});
%>
<nav class="breadcrumbs" aria-label="分类路径"><a href="<%= url_for('/topics/') %>">分类目录</a><% chen_trail(page.category).forEach(function (node) { %><span>›</span><a href="<%= url_for(node.path) %>"><%= node.name %></a><% }); %></nav>
<% var current = chen_tree().map.get(page.category); if (current && current.children.length) { %><div class="feed-filters"><% current.children.forEach(function (node) { %><a href="<%= url_for(node.path) %>"><%= node.name %> · <%= chen_category_posts(node.name).length %></a><% }); %></div><% } %>
<section class="list">
  <div class="list__head">
    <h1 class="list__title">分类 · <%= page.category %></h1>
    <span class="list__count"><%= list.length %> 篇</span>
  </div>
  <% if (list.length) { %>
    <div class="card-grid card-grid--list">
      <% list.forEach(function (post) { %>
        <%- partial('_partial/post-card', { post: post }) %>
      <% }); %>
    </div>
  <% } else { %>
    <p class="empty">该分类下还没有文章。</p>
  <% } %>
</section>
