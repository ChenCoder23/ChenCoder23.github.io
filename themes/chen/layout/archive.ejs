<section class="posts">
  <h1 class="page-title">归档</h1>
  <% var list = site.posts ? site.posts.sort('date', -1) : []; %>
  <% if (list.length){ %>
    <div class="archive-list">
      <% var currentYear = ''; list.forEach(function(post){ var y = date(post.date, 'YYYY'); if(y !== currentYear){ currentYear = y; %>
        <h2 class="archive-year"><%= y %></h2>
      <% } %>
        <div class="archive-item"><time><%= date(post.date, 'MM-DD') %></time><a href="<%= url_for(post.path) %>"><%= post.title %></a></div>
      <% }); %>
    </div>
  <% } else { %>
    <p class="empty">暂无归档。</p>
  <% } %>
</section>