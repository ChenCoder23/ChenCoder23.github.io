<%
var author = config.author || 'ChenBlog';
var words = chen_words(page.content);
var minutes = chen_reading_time(page.content, words);
var cats = (page.categories && page.categories.toArray) ? page.categories.toArray() : [];
var tags = (page.tags && page.tags.toArray) ? page.tags.toArray() : [];
var showEdit = !!(theme.admin && theme.admin.enabled !== false && theme.admin.editLink !== false);
var editUrl = url_for('/admin/') + '?edit=' + encodeURIComponent(page.source || '');
var all = site.posts ? site.posts.sort('date', -1).toArray() : [];
var idx = -1;
for (var i = 0; i < all.length; i++) { if (all[i].path === page.path) { idx = i; break; } }
var olderPost = (idx >= 0 && idx < all.length - 1) ? all[idx + 1] : null;
var newerPost = idx > 0 ? all[idx - 1] : null;
function navJson(post) {
  if (!post) return 'null';
  return JSON.stringify({ url: url_for(post.path), title: post.title }).replace(/</g, '\\u003c');
}
%>
<article class="article" id="article">
  <header class="article__head">
    <h1 class="article__title"><%= page.title %></h1>
    <div class="article__meta">
      <span class="meta-author">
        <span class="avatar" aria-hidden="true"><%= author.slice(0, 1) %></span>
        <span class="meta-author__name"><%= author %></span>
      </span>
      <time class="meta-item" datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY年M月D日') %></time>
      <% if (cats.length) { %>
        <span class="meta-group">
          <% cats.forEach(function (cat) { %>
            <a class="meta-chip meta-chip--cat" href="<%= url_for(cat.path) %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></svg><%= cat.name %></a>
          <% }); %>
        </span>
      <% } %>
      <% if (tags.length) { %>
        <span class="meta-group">
          <% tags.forEach(function (tag) { %>
            <a class="meta-chip" href="<%= url_for(tag.path) %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 2.8 12V4.8A2 2 0 0 1 4.8 2.8H12a2 2 0 0 1 1.4.6l7.2 7.2a2 2 0 0 1 0 2.8Z"/><circle cx="7.5" cy="7.5" r="1.4"/></svg><%= tag.name %></a>
          <% }); %>
        </span>
      <% } %>
      <span class="meta-item meta-item--muted"><%= words %> 字</span>
      <span class="meta-item meta-item--muted">约 <%= minutes %> 分钟</span>
    </div>
  </header>

  <%- partial('_partial/series') %>

  <% if (page.cover) { %>
    <img class="article__cover" src="<%= url_for(page.cover) %>" alt="<%= page.title %>" fetchpriority="high" decoding="async">
  <% } %>

  <div class="prose" id="prose"><%- page.content %></div>

  <footer class="article__foot">
    <div class="article__tools">
      <% if (showEdit) { %>
        <a class="tool-link" id="editLink" href="<%= editUrl %>" title="在后台直接编辑这篇文章">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>编辑本文
        </a>
      <% } %>
      <button class="tool-link" id="printBtn" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 9V3h10v6"/><path d="M7 19H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2"/><rect x="7" y="14" width="10" height="7" rx="1"/></svg>打印 / 存为 PDF
      </button>
      <button class="tool-link" id="topBtn" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20V4M5 11l7-7 7 7"/></svg>回到顶部
      </button>
    </div>

    <p class="article__stamp">写于 <%= date(page.date, 'YYYY-MM-DD') %><% if (page.updated && date(page.updated, 'YYYY-MM-DD') !== date(page.date, 'YYYY-MM-DD')) { %> · 更新于 <%= date(page.updated, 'YYYY-MM-DD') %><% } %></p>

    <% if (olderPost || newerPost) { %>
      <nav class="post-nav" aria-label="上一篇 / 下一篇">
        <% if (olderPost) { %>
          <a class="post-nav__item" href="<%= url_for(olderPost.path) %>">
            <em>上一篇</em>
            <span><%= olderPost.title %></span>
          </a>
        <% } %>
        <% if (newerPost) { %>
          <a class="post-nav__item post-nav__item--next" href="<%= url_for(newerPost.path) %>">
            <em>下一篇</em>
            <span><%= newerPost.title %></span>
          </a>
        <% } %>
      </nav>
    <% } %>
  </footer>
</article>

<%- partial('_partial/related') %>

<script>window.__CHEN_POST_NAV__ = { prev: <%- navJson(olderPost) %>, next: <%- navJson(newerPost) %> };</script>

<%- partial('_partial/comments') %>
